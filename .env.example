# ---------------------------------------------------------------- apps/api
# Postgres in production; `postgres://` and `postgresql://` URLs are normalised automatically.
DATABASE_URL=postgresql+psycopg://sailbase:sailbase@localhost:5432/sailbase
ENVIRONMENT=development                 # development | test | production
SECRET_KEY=change-me-use-32-plus-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000      # comma separated; empty means "*"
PUBLIC_WEB_URL=http://localhost:3000    # used for payment return links
SEED_ON_START=false                     # idempotent demo catalogue on boot
RUN_MIGRATIONS=1                        # container entrypoint runs `alembic upgrade head`
UPLOAD_DIR=./uploads                    # mount a volume here in production

# Payments
PAYMENT_PROVIDER=fake                   # fake | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEPOSIT_PERCENT=30

# Booking lifecycle
QUOTE_TTL_MINUTES=30
HOLD_TTL_MINUTES=45

# One-way charter economics
REPOSITIONING_CENTS_PER_NM=1500
REPOSITIONING_FIXED_CENTS=15000
REPOSITIONING_NM_PER_DAY=60
COASTAL_ROUTE_FACTOR=1.35
RETURN_LEG_PROBABILITY=0.5

# ---------------------------------------------------------------- apps/web
# Server-side only: the browser calls /api/* on the web service, which proxies to the API.
API_URL=http://localhost:8000
